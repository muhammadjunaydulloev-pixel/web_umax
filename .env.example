# Ин файл барои пайвасти AI API-и воқеӣ дар оянда пешбинӣ шудааст.
# Дар версияи ҳозираи Demo Mode (index.html), ҳеҷ API key лозим нест.
#
# Вақте ки backend-и воқеӣ (масалан Next.js API route ё сервери алоҳида) илова кунед,
# API key-ро танҳо дар он ҷо (сервер), НА дар браузер, нигоҳ доред.

# Мисол — агар аз Claude API барои таҳлили тасвир истифода баред:
ANTHROPIC_API_KEY=your_api_key_here

# Мисол — агар database/storage илова кунед (барои нигоҳдории аксҳо ва таърих дар сервер):
DATABASE_URL=
STORAGE_BUCKET_URL=
